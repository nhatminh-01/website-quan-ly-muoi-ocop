# Mẫu kết nối. Trên máy cộng tác viên thay các giá trị bằng thông tin production
# được gửi qua kênh riêng; không ghi mật khẩu thật vào tệp mẫu/commit.
# Nếu chạy database dev riêng, đổi PGDATABASE/PGUSER/PGHOST theo database dev.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ocop_db
PGUSER=ocop
PGPASSWORD=CHANGE_ME
PGSSLMODE=prefer

# Web server settings are optional.
SALT_WEB_HOST=0.0.0.0
SALT_WEB_PORT=8080
